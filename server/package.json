{
  "name": "hms-server",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "Hospital Management System - API server",
  "main": "src/server.js",
  "scripts": {
    "dev": "node --watch src/server.js",
    "start": "node src/server.js",
    "migrate": "knex --knexfile knexfile.js migrate:latest",
    "migrate:rollback": "knex --knexfile knexfile.js migrate:rollback --all",
    "seed": "node src/db/seed/index.js",
    "db:reset": "node src/db/seed/index.js",
    "test": "vitest run --config vitest.storage.config.js",
    "test:storage": "vitest run --config vitest.storage.config.js",
    "test:integration": "vitest run --config vitest.integration.config.js",
    "loadtest": "node scripts/loadtest.js"
  },
  "engines": {
    "node": ">=20"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.1163.0",
    "@smithy/node-http-handler": "^4.14.2",
    "bcryptjs": "^3.0.3",
    "cookie-parser": "^1.4.7",
    "cors": "^2.8.6",
    "dotenv": "^18.0.6",
    "express": "^5.2.1",
    "express-rate-limit": "^8.7.1",
    "helmet": "^8.3.0",
    "knex": "^3.3.0",
    "multer": "^2.4.0",
    "node-cron": "^4.6.0",
    "nodemailer": "^10.0.16",
    "pdfkit": "^0.20.2",
    "pg": "^8.23.1",
    "zod": "^3.25.76"
  },
  "devDependencies": {
    "autocannon": "^8.0.0",
    "supertest": "^7.3.1",
    "vitest": "^5.0.3"
  }
}
