{
  "name": "hms",
  "version": "1.0.0",
  "private": true,
  "description": "Hospital Management System — full-stack implementation of the HMS SRS v1.0",
  "workspaces": ["server", "client"],
  "engines": { "node": ">=20" },
  "scripts": {
    "migrate": "npm run migrate -w server",
    "seed": "npm run seed -w server",
    "db:reset": "npm run db:reset -w server",
    "dev:server": "npm run dev -w server",
    "dev:client": "npm run dev -w client",
    "build": "npm run build -w client",
    "start": "npm run start -w server",
    "test": "npm test -w server",
    "test:e2e": "npm run test:e2e -w client"
  }
}
