# Copy this file to server/.env for local configuration.
# Never commit real database credentials, SMTP passwords, encryption keys, or session secrets.

# --- Development / application ---
NODE_ENV=development
PORT=4000
HOSPITAL_NAME=City General Hospital
HOSPITAL_TZ=Asia/Karachi
CURRENCY=PKR
APP_BASE_URL=http://localhost:5173
# Comma-separated origins for browser/API access, for example: https://app.example.com
CORS_ORIGIN=http://localhost:5173

# --- PostgreSQL ---
# Local development database example. Replace these example credentials locally.
DATABASE_URL=postgresql://USER@localhost:5432/hms_dev
# Disposable local test database example. Never point this to production.
# Non-local test database hosts require the exact hostname in TEST_DATABASE_ALLOWED_HOSTS.
TEST_DATABASE_URL=postgresql://USER@localhost:5432/hms_test
# Required to opt in to destructive Vitest database setup; never enable in production.
ALLOW_TEST_DATABASE_RESET=false
# Exact dedicated confirmation required before integration rollback/reset or destructive test seeding.
TEST_DATABASE_RESET_CONFIRM=
# Exact non-local PostgreSQL hostnames for disposable test databases, comma-separated when multiple.
TEST_DATABASE_ALLOWED_HOSTS=
DB_POOL_MAX=20

# --- Encryption (required in production) ---
# Use two independently generated, 32-byte hexadecimal values in production.
DATA_ENCRYPTION_KEY=
BLIND_INDEX_KEY=

# --- Sessions and authentication ---
SESSION_IDLE_MINUTES=10
SESSION_ABSOLUTE_HOURS=12
LOGIN_MAX_ATTEMPTS=3
LOGIN_LOCK_MINUTES=15
LOGIN_RATE_LIMIT=100
RESET_TOKEN_HOURS=24
COOKIE_SECURE=false
TRUST_PROXY=false

# Optional direct HTTPS support. Normally TLS is terminated by a reverse proxy or hosting provider.
HTTPS_KEY_PATH=
HTTPS_CERT_PATH=

# --- Email ---
# Leave SMTP values blank in development to use the configured development mailbox.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM=HMS <no-reply@hospital.local>
SMTP_SECURE=false

# --- Files, backups, and scheduled jobs ---
UPLOAD_DIR=./storage/uploads
BACKUP_DIR=./storage/backups
BACKUP_RETENTION_DAYS=30
PG_DUMP_PATH=pg_dump
MAX_UPLOAD_MB=10
ENABLE_SCHEDULER=true
# Standard cron schedules; backup retention and scheduler behavior are handled by the backend.
BACKUP_CRON=0 0 * * *
HEALTH_CRON=0 * * * *

# --- Object storage ---
# Local development remains fully functional with STORAGE_PROVIDER=local.
# Production startup requires STORAGE_PROVIDER=r2 and rejects missing R2 settings.
STORAGE_PROVIDER=local
# Configure these values only in the backend when STORAGE_PROVIDER=r2.
# Never put R2 credentials or secrets in frontend variables.
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET_UPLOADS=
R2_BUCKET_BACKUPS=
R2_ENDPOINT=https://<account-id>.r2.cloudflarestorage.com
R2_REGION=auto

# --- Testing and load testing ---
# Used by server/scripts/loadtest.js and the optional browser smoke test.
BASE_URL=http://localhost:4000
CONNECTIONS=500
DURATION=20
DEMO_PASSWORD=change_me
# Optional executable path for Playwright Chromium on machines where browser discovery needs an override.
CHROMIUM_PATH=
